{
  "id": "NetherEnd",
  "name": "Nether & End",
  "version": "0.1.0",
  "category": "themes",
  "description": "Animated Nether and End themes with particles and glow. Toggle off/on after changing settings.",
  "author": "tomel999",
  "frontend": "frontend/index.js",
  "permissions": ["ui:theme"],
  "settings": [
    { "key": "theme", "type": "select", "label": "Motyw", "default": "nether", "options": ["nether", "end"] },
    { "key": "particles", "type": "bool", "label": "Cząsteczki", "default": true },
    { "key": "intensity", "type": "number", "label": "Liczba cząsteczek", "default": 70 }
  ]
}
